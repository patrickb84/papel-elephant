---
import Floral from '../components/Floral.astro';
import FloralRule from '../components/FloralRule.astro';
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { BOOKS } from '../lib/books';
import { CONTENT, withCites } from '../lib/site';

// Page text comes from content/site.yaml (books: ...); each book from content/books/.
const { books: page } = CONTENT;

// The back cover opens like a chapter: a drop cap, then the first words in small capitals.
const opening = (text: string) => {
  const words = text.split(' ');
  return { lead: words.slice(0, 3).join(' '), rest: withCites(words.slice(3).join(' ')) };
};
const external = (href: string) => /^https?:/.test(href);
---

<Base title={page.pageTitle} description={page.description}>
  <main id="main" class="books">
    <header class="page-head">
      <h1>{page.heading}</h1>
      <p class="lede">{page.lede}</p>
    </header>

    {BOOKS.map((book) => {
      const [first = '', ...rest] = book.blurb;
      const open = opening(first);
      return (
        <article class="book" id={book.slug} aria-labelledby={`${book.slug}-title`}>
          <FloralRule name="stem-rule" width="7.5rem" />
          <div class="hero">
            <figure class="cover" style={`--cover-bg: ${book.cover.colour}`}>
              <img
                src={`${book.cover.src}-850.webp`}
                srcset={`${book.cover.src}-425.webp 425w, ${book.cover.src}-850.webp 850w`}
                sizes="(min-width: 860px) 22rem, 62vw"
                width={book.cover.width}
                height={book.cover.height}
                alt={book.cover.alt}
                decoding="async"
              />
            </figure>
            <div class="head">
              <h2 id={`${book.slug}-title`}>{book.title}</h2>
              {book.subtitle && <p class="subtitle">{book.subtitle}</p>}
              <p class="byline">
                by {book.author}
                {book.authorNote && <span class="author-note">{book.authorNote}</span>}
              </p>
              <p class="hook">{book.hook}</p>
              <ul class="links">
                {book.links.map((link, i) => (
                  <li>
                    <a
                      class={i === 0 ? 'button button-primary' : 'button'}
                      href={link.href}
                      rel={external(link.href) ? 'noopener' : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="story">
            <div class="blurb">
              <p class="opening"><span class="lead">{open.lead}</span> <Fragment set:html={open.rest} /></p>
              {rest.map((p) => <p set:html={withCites(p)} />)}
            </div>
            <div class="side">
            <dl class="details">
              {book.details.map((row) => (
                <div>
                  <dt>{row.label}</dt>
                  <dd>
                    {row.value.split(' · ').map((part, i) => (
                      <>{i > 0 && ' · '}<span class="part">{part}</span></>
                    ))}
                  </dd>
                </div>
              ))}
            </dl>
            <Floral name="branch" class="side-floral" />
            </div>
          </div>
        </article>
      );
    })}

    <SiteFooter />
  </main>
</Base>

<style>
  .books {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  h1, h2 {
    font-family: var(--display);
    font-weight: 450;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-wrap: balance;
  }
  p { text-wrap: pretty; }

  .page-head { padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(1.5rem, 4vw, 2.5rem); }
  h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    line-height: 1.02;
  }
  .lede {
    margin: 0;
    font-size: clamp(1.2rem, 1.8vw, 1.45rem);
    line-height: 1.45;
    color: var(--ink-soft);
  }

  /* One book: the cover as frontispiece, its title page beside it ---------- */
  .book {
    padding: clamp(2.5rem, 6vw, 4.5rem) 0;
    border-top: 1px solid var(--rule);
    position: relative;
    scroll-margin-top: 1rem;
  }
  .hero {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  @media (min-width: 860px) {
    .hero { grid-template-columns: minmax(0, 22rem) 1fr; }
  }
  .cover {
    margin: 0;
    width: min(62vw, 18rem);
    justify-self: center;
    aspect-ratio: 850 / 1360;
    background: var(--cover-bg);
    /* The Laid Print Rule: only artwork lifts. */
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.12), 0 18px 40px -18px rgb(0 0 0 / 0.45);
  }
  @media (min-width: 860px) {
    .cover { width: 100%; }
  }
  .cover img { display: block; width: 100%; height: 100%; }

  h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
  }
  .subtitle {
    margin: 0.5rem 0 0;
    font-family: var(--display);
    font-style: italic;
    font-size: clamp(1.2rem, 1.8vw, 1.45rem);
    color: var(--ink-soft);
  }
  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    margin: 1.25rem 0 0;
    font-family: var(--sans);
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--ink);
  }
  .byline::before {
    content: '';
    width: 2.5rem;
    height: 1px;
    background: var(--foil);
  }
  .author-note { font-weight: 400; color: var(--ink-soft); }
  .hook {
    margin: 1.5rem 0 0;
    max-width: 30rem;
    font-size: clamp(1.2rem, 1.8vw, 1.45rem);
    line-height: 1.45;
    color: var(--ink);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .button {
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    padding: 0.65rem 1.4rem;
    font: 500 0.92rem/1 var(--sans);
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
  }
  .button:hover { border-color: var(--gold); }
  .button-primary { color: var(--paper); background: var(--ink); border-color: var(--ink); }
  .button-primary:hover { background: transparent; color: var(--ink); border-color: var(--gold); }
  @media (prefers-reduced-motion: reduce) {
    .button { transition: none; }
  }

  /* The back cover, with the listing facts set as a colophon beside it ----- */
  .story {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
  @media (min-width: 860px) {
    .story { grid-template-columns: minmax(0, 36rem) minmax(0, 26rem); justify-content: space-between; }
  }
  .blurb p {
    margin: 0 0 1.1rem;
    font-size: 1.12rem;
    line-height: 1.6;
    color: var(--ink);
  }
  .blurb p:last-child { margin-bottom: 0; }
  /* The Chapter Opening Rule: a gilt Playfair capital sunk three lines. */
  .opening::first-letter {
    initial-letter: 3;
    margin-right: 0.12em;
    font-family: var(--display);
    font-weight: 500;
    color: var(--gold);
  }
  @supports not (initial-letter: 3) {
    .opening::first-letter {
      float: left;
      font-size: 4.1em;
      line-height: 0.82;
      padding: 0.06em 0.1em 0 0;
    }
  }
  .lead { font-variant-caps: small-caps; letter-spacing: 0.02em; }

  .side { align-self: start; }
  .details { margin: 0; }
  /* A branch under the details, beside the longer blurb. */
  :global(.side-floral) { width: 9rem; margin: 3rem auto 0; --floral-opacity: 0.6; }
  @media (max-width: 859px) { :global(.side-floral) { display: none; } }
  .details div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--rule);
  }
  .details div:last-child { border-bottom: 1px solid var(--rule); }
  .details dt {
    padding-top: 0.15rem;
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
  }
  .details dd {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.45;
    color: var(--ink);
  }
  .details .part { white-space: nowrap; }

</style>
