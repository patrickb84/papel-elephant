---
import { NAV, SITE } from '../lib/site';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const current = (href: string) => (path === href ? 'page' : undefined);
const numerals = ['i', 'ii', 'iii', 'iv', 'v', 'vi', 'vii', 'viii'];
---

<header class="site-header">
  <a class="brand" href="/" aria-label={`${SITE.name}, home`}>
    <span class="brand-mark" aria-hidden="true"></span>
    <span class="brand-rule" aria-hidden="true"></span>
    <span class="brand-word" aria-hidden="true"><span>Paper</span><span>Elephant</span><span>Publishing</span></span>
  </a>

  <!-- Wide screens (and phones without JavaScript): the links in the bar. -->
  <nav class="nav-bar" aria-label="Main">
    <ul>
      {NAV.map((item) => (
        <li><a href={item.href} aria-current={current(item.href)}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <!-- Narrow screens: a Menu button that opens the links in a drawer. -->
  <button class="menu-button" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="menu-drawer">
    <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
      <path d="M2 5.5h16M2 10h16M2 14.5h16" />
    </svg>
    <span>Menu</span>
  </button>

  <dialog class="drawer" id="menu-drawer" aria-label="Menu">
    <div class="drawer-inner">
      <div class="drawer-top">
        <button class="drawer-close" type="button">
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
            <path d="M4.5 4.5l11 11M15.5 4.5l-11 11" />
          </svg>
          <span>Close</span>
        </button>
      </div>
      <!-- Set like a book's contents page: roman numerals and display type. -->
      <nav aria-label="Menu">
        <ul>
          {NAV.map((item, i) => (
            <li style={`--i: ${i}`}>
              <a href={item.href} aria-current={current(item.href)}>
                <span class="toc-n" aria-hidden="true">{numerals[i] ?? i + 1}.</span>
                <span class="toc-label">{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <!-- Ways to get in touch, and the elephant, at the foot of the drawer. -->
      <div class="drawer-bottom">
        <ul class="drawer-foot">
          <li><a href={SITE.contactLink.href}>{SITE.contactLink.label}</a></li>
          <li><a href={SITE.instagram.href} rel="noopener">{SITE.instagram.label}</a></li>
        </ul>
        <span class="drawer-mark" aria-hidden="true"></span>
      </div>
    </div>
  </dialog>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const drawer = document.querySelector<HTMLDialogElement>('#menu-drawer');
  if (button && drawer) {
    const close = () => drawer.open && drawer.close();
    button.addEventListener('click', () => {
      drawer.showModal();
      button.setAttribute('aria-expanded', 'true');
    });
    drawer.addEventListener('close', () => {
      button.setAttribute('aria-expanded', 'false');
      button.focus({ preventScroll: true });
    });
    drawer.querySelector('.drawer-close')?.addEventListener('click', close);
    // Links close the drawer, so one to this page (About's #contact) lands visibly.
    drawer.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
    // A click on the dimmed page outside the drawer lands on the dialog itself.
    drawer.addEventListener('click', (event) => event.target === drawer && close());
    // Widening the window past the breakpoint puts the links back in the bar.
    matchMedia('(min-width: 720px)').addEventListener('change', (event) => event.matches && close());
  }
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--header-h);
    padding: 0 var(--gutter);
    border-bottom: 1px solid var(--rule);
  }

  /* Lock-up after the brand logo: elephant, a thin rule, the name in three lines. */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--ink);
    text-decoration: none;
  }
  .brand-mark {
    width: 2.75rem;
    height: 3.25rem;
    background: var(--foil-mark);
    -webkit-mask: url('/brand/elephant-mask.png') center / contain no-repeat;
    mask: url('/brand/elephant-mask.png') center / contain no-repeat;
    transition: transform 300ms ease;
  }
  .brand:hover .brand-mark { transform: rotate(-4deg); }
  .brand-rule {
    width: 1.5px;
    height: 3.1rem;
    background: var(--foil-mark);
  }
  .brand-word {
    display: flex;
    flex-direction: column;
    font-family: var(--display);
    font-size: 1.04rem;
    font-weight: 460;
    line-height: 0.96;
    letter-spacing: 0.005em;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Links in the bar -------------------------------------------------------- */
  .nav-bar ul {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
  }
  .nav-bar a {
    position: relative;
    display: inline-block;
    padding: 0.5rem 0;
    font-family: var(--sans);
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 160ms ease;
  }
  .nav-bar a:hover, .nav-bar a[aria-current='page'] { color: var(--ink); }
  .nav-bar a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.2rem;
    height: 1px;
    background: var(--foil);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms ease;
  }
  .nav-bar a:hover::after, .nav-bar a[aria-current='page']::after { transform: scaleX(1); }

  /* The Menu button and the drawer, on narrow screens with JavaScript ------- */
  .menu-button, .drawer-close {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 0.95rem;
    font: 500 0.92rem/1 var(--sans);
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 160ms ease;
  }
  .menu-button:hover, .drawer-close:hover { border-color: var(--gold); }
  .menu-button svg, .drawer-close svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .menu-button { display: none; }

  @media (max-width: 719.98px) {
    :global(html.js) .nav-bar { display: none; }
    :global(html.js) .menu-button { display: inline-flex; }
    /* Without JavaScript the links stay in the bar, under the brand if they must. */
    :global(html:not(.js)) .site-header { flex-wrap: wrap; height: auto; padding-block: 0.75rem; }
  }

  .drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(22rem, 86vw);
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    color: var(--ink);
    background: var(--paper);
    border: 0;
    border-left: 1px solid var(--rule);
    transform: translateX(100%);
    transition: transform 320ms cubic-bezier(0.2, 0.7, 0.2, 1), overlay 320ms allow-discrete, display 320ms allow-discrete;
  }
  .drawer[open] { transform: none; }
  @starting-style {
    .drawer[open] { transform: translateX(100%); }
  }
  .drawer::backdrop {
    background: rgb(23 21 17 / 0);
    transition: background-color 320ms ease, overlay 320ms allow-discrete, display 320ms allow-discrete;
  }
  .drawer[open]::backdrop { background: rgb(23 21 17 / 0.45); }
  @starting-style {
    .drawer[open]::backdrop { background: rgb(23 21 17 / 0); }
  }
  :global(html:has(.drawer[open])) { overflow: hidden; }

  .drawer-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.25rem var(--gutter) 2rem;
  }
  .drawer-top {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: 1.5rem;
  }
  .drawer nav li { border-bottom: 1px solid var(--rule); }
  .drawer nav a {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.85rem 0 0.95rem;
    font-family: var(--display);
    font-size: clamp(1.9rem, 9vw, 2.4rem);
    font-weight: 450;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 160ms ease;
  }
  .toc-n {
    min-width: 2.2rem;
    font-style: italic;
    font-size: 0.55em;
    color: var(--gold);
  }
  .toc-label {
    background: var(--foil) left bottom / 0 1px no-repeat;
    padding-bottom: 0.1em;
    transition: background-size 260ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .drawer nav a:hover, .drawer nav a[aria-current='page'] { color: var(--ink); }
  /* The current page is underlined in gilt, like the bar's links. */
  .drawer nav a[aria-current='page'] .toc-label, .drawer nav a:hover .toc-label { background-size: 100% 1px; }

  /* The entries settle in one after another as the drawer opens. */
  .drawer nav li {
    transition: opacity 420ms ease calc(80ms + var(--i) * 60ms), transform 520ms cubic-bezier(0.2, 0.7, 0.2, 1) calc(80ms + var(--i) * 60ms);
  }
  @starting-style {
    .drawer[open] nav li { opacity: 0; transform: translateX(1.5rem); }
  }

  /* Contact and Instagram bottom left, the elephant bottom right. */
  .drawer-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.5rem;
  }
  .drawer-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
  }
  .drawer-mark {
    flex: none;
    width: 4.25rem;
    height: 5rem;
    background: var(--foil-mark);
    -webkit-mask: url('/brand/elephant-mask.png') center / contain no-repeat;
    mask: url('/brand/elephant-mask.png') center / contain no-repeat;
  }
  .drawer-foot a {
    display: inline-block;
    padding: 0.6rem 0;
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration-color: var(--gold-soft);
  }
  .drawer-foot a:hover { color: var(--ink); text-decoration-color: var(--gold); }

  @media (prefers-reduced-motion: reduce) {
    .brand-mark, .nav-bar a::after, .drawer, .drawer::backdrop, .menu-button, .drawer-close,
    .drawer nav a, .toc-label, .drawer nav li { transition: none; }
  }
</style>
